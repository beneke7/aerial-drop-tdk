FoamFile
{
 version 2.0;
 format ascii;
 class volScalarField;
 object alpha.water;
}

dimensions [0 0 0 0 0 0 0];
internalField uniform 0;
boundaryField
{
    gasInlet
    {
        type fixedValue;
        value uniform 0;
    }
    downstreamOutlet
    {
        type inletOutlet;
        inletValue uniform 0;
        value uniform 0;
    }
    bottomOutlet
    {
        type inletOutlet;
        inletValue uniform 0;
        value uniform 0;
    }
    spanwiseMinus
    {
        type inletOutlet;
        inletValue uniform 0;
        value uniform 0;
    }
    spanwisePlus
    {
        type inletOutlet;
        inletValue uniform 0;
        value uniform 0;
    }
    aircraftWall
    {
        type constantAlphaContactAngle;
        theta0 90;
        limit gradient;
        value uniform 0;
    }
    nozzle
    {
        type fixedValue;
        value uniform 1;
    }
}
