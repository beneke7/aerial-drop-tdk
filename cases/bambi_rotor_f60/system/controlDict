FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}
application interIsoFoam;
startFrom latestTime;
startTime 0;
stopAt endTime;
endTime 9.7;
deltaT 0.0001;
adjustTimeStep yes;
maxCo 1;
maxAlphaCo 0.5;
maxDeltaT 0.001;
writeControl adjustableRunTime;
writeInterval 0.5;
purgeWrite 0;
writeFormat binary;
writePrecision 12;
writeCompression off;
timeFormat fixed;
timePrecision 12;
runTimeModifiable false;
OptimisationSwitches
{
    fileHandler collated;
    maxThreadFileBufferSize 0;
    writeNowSignal 10;
    stopAtWriteNowSignal 12;
}
functions
{
    // mean air velocity over the drain, for parcels flown through the wake
    UMeanDrain { type fieldAverage; libs (fieldFunctionObjects); timeStart 3.0; restartOnRestart false;
        restartOnOutput false; writeControl writeTime; fields ( U { mean on; prime2Mean off; base time; } ); }
    rotorDisk { type volFieldValue; libs (fieldFunctionObjects); regionType cellZone; name rotorDiskCells;
        operation volAverage; fields (U alpha.water); writeFields false; writeControl timeStep; writeInterval 10; }
    // whole-domain centre plane (wake and liquid) every 0.1 s, for pictures of the wake
    wakePlane { type surfaces; libs (sampling); surfaceFormat vtk; formatOptions { vtk { format binary; } }
        writeControl adjustableRunTime; writeInterval 0.1; fields (alpha.water U);
        surfaces { wake { type cuttingPlane; planeType pointAndNormal;
            pointAndNormalDict { point (0 0 0); normal (0 0 1); } interpolate false; } } }
    waterVolume
    {
        type volFieldValue;
        libs (fieldFunctionObjects);
        fields (alpha.water);
        operation volIntegrate;
        regionType all;
        writeFields false;
        executeControl timeStep;
        executeInterval 1;
        writeControl timeStep;
        writeInterval 1;
    }
    nozzleFlux
    {
        type surfaceFieldValue;
        libs (fieldFunctionObjects);
        regionType patch;
        name nozzle;
        operation sum;
        fields (phi alphaPhi_);
        writeFields false;
        executeControl timeStep;
        executeInterval 1;
        writeControl timeStep;
        writeInterval 1;
    }
    gasInletFlux
    {
        type surfaceFieldValue;
        libs (fieldFunctionObjects);
        regionType patch;
        name gasInlet;
        operation sum;
        fields (phi alphaPhi_);
        writeFields false;
        executeControl timeStep;
        executeInterval 1;
        writeControl timeStep;
        writeInterval 1;
    }
    downstreamOutletFlux
    {
        type surfaceFieldValue;
        libs (fieldFunctionObjects);
        regionType patch;
        name downstreamOutlet;
        operation sum;
        fields (phi alphaPhi_);
        writeFields false;
        executeControl timeStep;
        executeInterval 1;
        writeControl timeStep;
        writeInterval 1;
    }
    bottomOutletFlux
    {
        type surfaceFieldValue;
        libs (fieldFunctionObjects);
        regionType patch;
        name bottomOutlet;
        operation sum;
        fields (phi alphaPhi_);
        writeFields false;
        executeControl timeStep;
        executeInterval 1;
        writeControl timeStep;
        writeInterval 1;
    }
    spanwiseMinusFlux
    {
        type surfaceFieldValue;
        libs (fieldFunctionObjects);
        regionType patch;
        name spanwiseMinus;
        operation sum;
        fields (phi alphaPhi_);
        writeFields false;
        executeControl timeStep;
        executeInterval 1;
        writeControl timeStep;
        writeInterval 1;
    }
    spanwisePlusFlux
    {
        type surfaceFieldValue;
        libs (fieldFunctionObjects);
        regionType patch;
        name spanwisePlus;
        operation sum;
        fields (phi alphaPhi_);
        writeFields false;
        executeControl timeStep;
        executeInterval 1;
        writeControl timeStep;
        writeInterval 1;
    }
    bucketFlux
    {
        type surfaceFieldValue;
        libs (fieldFunctionObjects);
        regionType patch;
        name bucket;
        operation sum;
        fields (phi alphaPhi_);
        writeFields false;
        executeControl timeStep;
        executeInterval 1;
        writeControl timeStep;
        writeInterval 1;
    }
    alphaExtrema
    {
        type fieldMinMax;
        libs (fieldFunctionObjects);
        fields (alpha.water);
        location false;
        log true;
        writePrecision 12;
        executeControl timeStep;
        executeInterval 1;
        writeControl timeStep;
        writeInterval 1;
    }
    speedExtrema
    {
        type fieldMinMax;
        libs (fieldFunctionObjects);
        mode magnitude;
        fields (U);
        location false;
        log true;
        writePrecision 12;
        executeControl timeStep;
        executeInterval 1;
        writeControl timeStep;
        writeInterval 1;
    }
    failureLocations
    {
        type fieldMinMax;
        libs (fieldFunctionObjects);
        mode magnitude;
        fields (U p_rgh k epsilon nut);
        location true;
        log true;
        writePrecision 12;
        executeControl timeStep;
        executeInterval 1;
        writeControl timeStep;
        writeInterval 1;
    }
    #include "liquidBand"
    #include "jetProfile"
    #include "renderSurfacesLiveRouaix"
}
