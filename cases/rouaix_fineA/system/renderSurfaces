FoamFile { version 2.0; format ascii; class dictionary; object renderSurfaces; }
// 3D render input for Rouaix cases: liquid iso-surfaces and the spanwise centre plane (z = 0).
functions
{
    renderSurfaces
    {
        type surfaces; libs (sampling); surfaceFormat vtk;
        formatOptions { vtk { format binary; } }
        interpolationScheme cellPoint; fields (alpha.water U p);
        surfaces
        {
            jet50 { type isoSurface; isoField alpha.water; isoValue 0.5; interpolate true; }
            jet10 { type isoSurface; isoField alpha.water; isoValue 0.1; interpolate true; }
            centre { type cuttingPlane; planeType pointAndNormal; pointAndNormalDict { point (0 0 0); normal (0 0 1); }
                     interpolate false; bounds (-2.5 -10 -0.1) (12 0.01 0.1); }
        }
    }
}
